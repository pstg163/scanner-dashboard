# Public project URL. Safe to ship in the client.
VITE_SUPABASE_URL=https://dfquewlihcgbrbhuwlgf.supabase.co

# Publishable key. Safe for a browser. Never put a service-role key here.
# The dashboard function has verify_jwt off, so the app does not send this
# unless VITE_SUPABASE_USE_APIKEY=true.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_2CFcR9fnE1treAI2Jk1ITA_KJ8lX-QX
VITE_SUPABASE_USE_APIKEY=false

# Public path the built files are served from. Root hosting stays '/'.
# Subpath examples: /scanner/   /functions/v1/dashboard/   /<github-repo>/
# Leading slash required. A trailing slash is added if you leave it off.
VITE_BASE_PATH=/
